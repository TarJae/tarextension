{
  "name": "tarextension",
  "version": "1.1.0",
  "private": true,
  "description": "Personal Pi extensions by TarJae",
  "keywords": ["pi-package", "pi-extension"],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/TarJae/tarextension.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/package.test.ts tarextension-pi-project-switcher/tests/project-switcher.test.ts tarextension-pi-start-menu/tests/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./tarextension-pi-project-switcher/extensions/project-switcher.ts",
      "./tarextension-pi-start-menu/extensions/start-menu.ts"
    ]
  }
}
